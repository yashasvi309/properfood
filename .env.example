# =====================================================================
# PROPERFOOD: GOOGLE GEMINI API CONFIGURATION
# =====================================================================
# Get your free API key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY="AIzaSyYourActualGeminiApiKeyHere"

# Model Options on Google AI Studio:
# - gemini-2.5-flash       (Fastest, supports native JSON mode & system instructions)
# - gemini-2.5-pro         (Deepest reasoning for complex clinical audits)
# - gemma-3-27b-it         (Open-weight Gemma model hosted on the Gemini API)
GEMINI_MODEL="gemini-2.5-flash"

# Pacing delay between agents (in seconds) to respect free-tier RPM limits
AGENT_COOLDOWN_SECONDS="1"